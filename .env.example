# Environment Variables
# Copy this file to .env.local and fill in your values

# Google Analytics 4 Measurement ID
# Get this from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console Verification Code
# Get this from: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ─── Google Ads conversion tracking ───────────────────────────────────────────
# Without these the site sends NO conversion signal to Google Ads: Smart Bidding
# optimises blind and the search-terms report shows 0 conversions on every row.
#
# 1. Google Ads > Goals > Conversions > New conversion action > Website
# 2. Create two actions: "Phone Click" and "Booking Started"
# 3. Choose "Install the tag yourself" and copy the values below from the snippet
#    (send_to looks like AW-123456789/AbC-D_efGh12345)
NEXT_PUBLIC_ADS_CONVERSION_ID=
NEXT_PUBLIC_ADS_LABEL_PHONE=
NEXT_PUBLIC_ADS_LABEL_BOOKING=
